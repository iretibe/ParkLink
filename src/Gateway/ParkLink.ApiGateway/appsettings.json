{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },

      "vehicles-route": {
        "ClusterId": "vehicles-cluster",
        "Match": {
          "Path": "/api/vehicles/{**catch-all}"
        }
      },

      "parking-route": {
        "ClusterId": "parking-cluster",
        "Match": {
          "Path": "/api/parking/{**catch-all}"
        }
      },

      "reservations-route": {
        "ClusterId": "reservations-cluster",
        "Match": {
          "Path": "/api/reservations/{**catch-all}"
        }
      },

      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },

      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },

      "gates-route": {
        "ClusterId": "gates-cluster",
        "Match": {
          "Path": "/api/gates/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "users-destination": {
            "Address": "https+http://parking-users"
          }
        }
      },

      "vehicles-cluster": {
        "Destinations": {
          "vehicles-destination": {
            "Address": "https+http://parking-vehicle"
          }
        }
      },

      "parking-cluster": {
        "Destinations": {
          "parking-destination": {
            "Address": "https+http://parking-parking"
          }
        }
      },

      "reservations-cluster": {
        "Destinations": {
          "reservations-destination": {
            "Address": "https+http://parking-reservation"
          }
        }
      },

      "payments-cluster": {
        "Destinations": {
          "payments-destination": {
            "Address": "https+http://parking-payment"
          }
        }
      },

      "notifications-cluster": {
        "Destinations": {
          "notifications-destination": {
            "Address": "https+http://parking-notification"
          }
        }
      },

      "gates-cluster": {
        "Destinations": {
          "gates-destination": {
            "Address": "https+http://parking-gate"
          }
        }
      }
    }
  },
  "Identity": {
    "Authority": "https://localhost:5001"
    //"Authority": "https://parking-identity"
  }
}
