@using ParkLink.Shared.Models.Dashboard

<MudCard Elevation="1" Class="pa-4 rounded-xl h-100">

    <div class="d-flex align-center justify-space-between mb-3">
        <MudText Typo="Typo.h6" Class="font-weight-bold">
            System Notifications
        </MudText>

        <MudLink Href="/notifications" Typo="Typo.body2"
                 Color="Color.Primary" Underline="Underline.None">
            View all
        </MudLink>
    </div>

    <div class="d-flex flex-column gap-3 mt-3">
        @foreach (var note in Notifications)
        {
            <div class="d-flex align-start gap-3 pb-2 border-bottom">

                <MudIcon Icon="@GetNotificationIcon(note.Type)"
                         Color="@GetNotificationColor(note.Type)"
                         Class="mt-1" />

                <div class="flex-grow-1">
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.body2" Class="font-weight-bold">
                            @note.Title
                        </MudText>

                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @note.TimeAgo
                        </MudText>
                    </div>

                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @note.Description
                    </MudText>
                </div>
            </div>
        }
    </div>

    <div class="d-flex align-center gap-2 mt-4 pt-2">
        <span class="legend-dot bg-success"></span>
        <MudText Typo="Typo.caption"
                 Class="mud-text-secondary">
            All systems are running smoothly.
        </MudText>
    </div>
</MudCard>

@code {
    [Parameter]
    public List<SystemNotificationModel> Notifications { get; set; } = [];

    private static string GetNotificationIcon(string type) =>
        type switch
        {
            "Success" => Icons.Material.Filled.CheckCircle,
            "Info" => Icons.Material.Filled.Info,
            "Warning" => Icons.Material.Filled.Warning,
            _ => Icons.Material.Filled.Notifications
        };

    private static Color GetNotificationColor(string type) =>
        type switch
        {
            "Success" => Color.Success,
            "Info" => Color.Info,
            "Warning" => Color.Warning,
            _ => Color.Primary
        };
}