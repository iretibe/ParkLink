@using ParkLink.Shared.Models.Dashboard

<MudCard Elevation="1" Class="pa-4 rounded-xl h-100">

    <div class="d-flex align-center justify-space-between mb-2">

        <MudText Typo="Typo.h6"
                 Class="font-weight-bold">
            Recent Reservations
        </MudText>

        <MudLink Href="/reservations"
                 Typo="Typo.body2"
                 Color="Color.Primary"
                 Underline="Underline.None">
            View all
        </MudLink>

    </div>

    <div class="d-flex flex-column gap-3 mt-3">

        @foreach (var res in Reservations)
        {
            <div class="d-flex align-center justify-space-between pb-2 border-bottom">

                <div class="d-flex align-center gap-3">

                    <MudAvatar Color="Color.Primary"
                               Size="Size.Medium">
                        @res.Initials
                    </MudAvatar>

                    <div>

                        <MudText Typo="Typo.body2"
                                 Class="font-weight-bold">
                            @res.Name
                        </MudText>

                        <MudText Typo="Typo.caption"
                                 Color="Color.Primary">
                            @res.Slot
                        </MudText>

                    </div>

                </div>

                <div class="text-right">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @res.Time
                    </MudText>

                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(res.Status == "Active" ? Color.Success : Color.Default)"
                             Variant="Variant.Text">
                        @res.Status
                    </MudChip>

                </div>

            </div>
        }

    </div>

</MudCard>

@code {
    [Parameter]
    public List<ReservationModel> Reservations { get; set; } = [];
}