<MudDrawer Elevation="0"
           Open="true"
           Variant="DrawerVariant.Persistent"
           Class="blue-sidebar text-white">

    <!-- Brand -->
    <div class="pa-4 d-flex align-center gap-2">

        <div class="brand-logo-icon">
            P
        </div>

        <div>
            <MudText Typo="Typo.h6"
                     Class="font-weight-bold white-text">
                ParkLink
            </MudText>

            <MudText Typo="Typo.caption"
                     Style="color: rgba(255,255,255,0.7); font-size:10px;">
                Smart Parking, Smarter Cities
            </MudText>
        </div>

    </div>

    <MudDivider Style="border-color: rgba(255,255,255,.10);" />

    <!-- Navigation -->
    <MudNavMenu Class="pa-2 custom-nav-menu">

        <MudNavLink Href="/"
                    Match="NavLinkMatch.All"
                    Icon="@Icons.Material.Filled.Dashboard">
            Dashboard
        </MudNavLink>

        <MudNavLink Href="/parking"
                    Icon="@Icons.Material.Filled.LocalParking">
            Live Parking
        </MudNavLink>

        <MudNavLink Href="/reservations"
                    Icon="@Icons.Material.Filled.CalendarMonth">
            Reservations
        </MudNavLink>

        <MudNavLink Href="/payments"
                    Icon="@Icons.Material.Filled.Payment">
            Payments
        </MudNavLink>

        <MudNavLink Href="/vehicles"
                    Icon="@Icons.Material.Filled.DirectionsCar">
            Vehicles
        </MudNavLink>

        <MudNavLink Href="/users"
                    Icon="@Icons.Material.Filled.Group">
            Users
        </MudNavLink>

        <MudNavLink Href="/notifications"
                    Icon="@Icons.Material.Filled.Notifications">
            Notifications
        </MudNavLink>

        <MudNavLink Href="/reports"
                    Icon="@Icons.Material.Filled.BarChart">
            Reports
        </MudNavLink>

        <MudNavLink Href="/settings"
                    Icon="@Icons.Material.Filled.Settings">
            Settings
        </MudNavLink>

    </MudNavMenu>

    <MudSpacer />

    <!-- System Status -->
    <div class="pa-4">

        <div class="mb-3 d-flex align-center gap-2">

            <span class="legend-dot bg-success"></span>

            <MudText Typo="Typo.caption"
                     Class="white-text">
                All Systems Operational
            </MudText>

        </div>

        <!-- Weather -->
        <div class="weather-widget pa-3 rounded-xl">

            <div class="d-flex align-center justify-space-between">

                <div>

                    <MudText Typo="Typo.h6"
                             Class="font-weight-bold white-text">
                        28°C
                    </MudText>

                    <MudText Typo="Typo.caption"
                             Style="color:rgba(255,255,255,.8)">
                        Accra, Ghana
                    </MudText>

                    <MudText Typo="Typo.caption"
                             Style="color:rgba(255,255,255,.7)">
                        Partly Cloudy
                    </MudText>

                </div>

                <MudIcon Icon="@Icons.Material.Filled.WbSunny"
                         Size="Size.Large"
                         Style="color:#ffeb3b;" />

            </div>

        </div>

    </div>

</MudDrawer>